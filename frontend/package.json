{
  "name": "a-little-universe-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "npm run lint && npm run test:desktop && npm test && npm run build",
    "desktop:dev": "node electron/dev.cjs",
    "desktop:ffmpeg:mac": "bash scripts/build-ffmpeg-macos-arm64.sh",
    "test:desktop": "node --test electron/*.test.cjs",
    "build:mac:dir": "npm run build && node electron/verify-macos-ffmpeg.cjs && electron-builder --mac dir --arm64",
    "smoke:desktop": "npm run build && node electron/bundle-smoke.cjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fflate": "^0.8.3",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "gsap": "3.15.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.alittleuniverse.foryou",
    "productName": "A Little Universe for You",
    "asar": true,
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.entertainment",
      "extendInfo": {
        "NSCameraUsageDescription": "A Little Universe for You uses the camera to record your reaction after you confirm.",
        "NSMicrophoneUsageDescription": "A Little Universe for You uses the microphone to record audio after you confirm.",
        "NSScreenCaptureUsageDescription": "A Little Universe for You records the film window after you confirm."
      },
      "extraResources": [
        {
          "from": "resources/macos-arm64",
          "to": "ffmpeg",
          "filter": ["**/*"]
        }
      ]
    }
  }
}
